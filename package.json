{
  "name": "business-lead-finder",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node ./scripts/dev/start-web.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:dev": "node ./scripts/dev/start-web.mjs",
    "web:build": "pnpm --filter @business-lead-finder/web run build",
    "web:test": "pnpm --filter @business-lead-finder/web run test",
    "workers:run": "python3 -m workers",
    "workers:test": "python3 -m pytest services/workers/tests"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
